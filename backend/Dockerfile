
FROM python:3.11-slim
# установка рабочей директории внутри контейнера
WORKDIR /app
#копируем файл с компа в образ
COPY requirements.txt .
#выполняется во время сборки образа - установка библиотек и не сохранять локальный кэш установочных файлов, чтоб образ занимал меньше места
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/

#копируем конфигурацию и файлы миграций Alembic
COPY alembic.ini .
COPY migrations/ ./migrations/

#документируем порт приложения
EXPOSE 8000
#выполняется при запуске контейнера 
# запускаем сервер unicorn, он запускает приложение (принимая подключения не только внутри контейнера, сервер на порту 8000) app в фале main папке app 
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
